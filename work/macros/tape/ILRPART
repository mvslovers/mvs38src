*                                                               02S0042 00009700
*         5 PARTLCNT FIXED(15),     /* COUNT OF ACTIVE LOCAL PAGE       00009800
*                                      DATA SETS                     */ 00009900
*         5 * CHAR(6),              /* RESERVED                      */ 00010000
