*                                      SPILLING WRITE REQUESTS TO THE   00011800
*                                      PLPA DATA SET.                */ 00011900
*           7 PARTSPLF PTR(31),     /* ADDRESS OF FIRST IOE          */ 00012000
*           7 PARTSPLL PTR(31),     /* ADDRESS OF LAST IOE           */ 00012100
*         5 PARTDUPQ CHAR(8) BDY(DWORD),/* DUPLEX WRITE QUEUE.  02S0042 00012200
*                                      CONTAINS IOE'S FOR WRITE 02S0042 00012300
*                                      OPERATIONS TO THE DUPLEX PAGE    00012400
*                                      DATA SET WHEN DUPLEXING IS       00012500
*                                      ACTIVE                        */ 00012600
*           7 PARTDUPF PTR(31),     /* ADDRESS OF FIRST IOE          */ 00012700
*           7 PARTDUPL PTR(31),     /* ADDRESS OF LAST IOE           */ 00012800
*         5 PARTLOCQ CHAR(8) BDY(DWORD),/* LOCAL WRITE QUEUE.   02S0042 00012900
*                                      CONTAINS IOE'S FOR WRITE 02S0042 00013000
*                                      OPERATIONS TO THE LOCAL DATA     00013100
*                                      SETS                          */ 00013200
*           7 PARTLOCF PTR(31),     /* ADDRESS OF FIRST IOE          */ 00013300
*           7 PARTLOCL PTR(31),     /* ADDRESS OF LAST IOE           */ 00013400
*       3 PARTENTS(*) CHAR(64) BDY(DWORD);/* THE PART ENTRIES. ONE      00013500
*                                      PARTE REPRESENTS ONE PAGE DATA   00013600
*                                      SET. A PARTE IS BUILT FOR EACH   00013700
*                                      PAGE DATA SET OPENED AT IPL      00013800
*                                      TIME AND FOR EACH POTENTIAL      00013900
*                                      DATA SET THAT CAN BE ADDED       00014000
*                                      LATER UP TO A MAXIMUM OF 64      00014100
*                                      TOTAL ENTRIES.                */ 00014200
*/********************************************************************/ 00014300
*/*                                                                  */ 00014400
*/*  THIS STRUCTURE MAPS A PART ENTRY.                               */ 00014500
*/*                                                                  */ 00014600
*/********************************************************************/ 00014700
*                                                               02S0043 00014800
