*                                      WRITE QUEUES                  */ 00010600
*         5 PARTCOMQ CHAR(8) BDY(DWORD),/* COMMON WRITE QUEUE.  02S0042 00010700
*                                      CONTAINS IOE'S FOR WRITE 02S0042 00010800
*                                      OPERATIONS TO THE PLPA(ON COLD   00010900
*                                      START ONLY) OR COMMON PAGE       00011000
*                                      DATA SETS                     */ 00011100
*           7 PARTCOMF PTR(31),     /* ADDRESS OF FIRST IOE          */ 00011200
*           7 PARTCOML PTR(31),     /* ADDRESS OF LAST IOE           */ 00011300
*         5 PARTSPLQ CHAR(8) BDY(DWORD),/* SPILL WRITE QUEUE.   02S0042 00011400
