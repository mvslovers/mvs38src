*                                      PROCESSING THIS PARTE 0=SLOT     00015600
*                                      SORT NOT IN PROGRESS FOR THIS    00015700
*                                      PARTE                         */ 00015800
*           7 * BIT(7),             /* RESERVED                      */ 00015900
*         5 PAREIORN FIXED(8),      /* NUMBER OF IORB'S BUILT FOR       00016000
*                                      THIS PARTE                    */ 00016100
*         5 PARECPCT FIXED(16),     /* LOCK COUNT USED FOR RECOVERY  */ 00016200
*       3 PARETYPE CHAR(1),         /* PAGE DATA SET TYPE FLAGS      */ 00016300
*         5 PAREPLPA BIT(1),        /* PARTE FOR PLPA DATA SET       */ 00016400
*         5 PARECOMM BIT(1),        /* PARTE FOR COMMON DATA SET     */ 00016500
*         5 PAREDPLX BIT(1),        /* PARTE FOR DUPLEX DATA SET     */ 00016600
*         5 PARELOCL BIT(1),        /* PARTE FOR LOCAL DATA SET      */ 00016700
*         5 * BIT(4),               /* UNUSED                        */ 00016800
*       3 PAREFLG1 CHAR(1),         /* PARTE FLAGS                   */ 00016900
*         5 PARENUSE BIT(1),        /* PARTE NOT IN USE FLAG 1=PARTE    00017000
*                                      NOT IN USE 0=PARTE IN USE     */ 00017100
*         5 PAREDSBD BIT(1),        /* DATA SET BAD FLAG 1=ASM HAS      00017200
*                                      DETECTED ERRORS INDICATING       00017300
*                                      THIS PAGE DATA SET IS NOT        00017400
*                                      USEFUL FOR PAGING. IT IS 02S0043 00017500
*                                      EFFECTIVELY NOT IN USE. 0=PAGE   00017600
*                                      DATA SET SATISFACTORY FOR USE.*/ 00017700
*         5 PAREINCP BIT(1),        /* INTERCEPTED FLAG. MEANINGFUL     00017800
*                                      ONLY IF DUPLEXING ACTIVE 02S0043 00017900
*                                      1=PLPA OR COMMON DATA SET        00018000
*                                      TEMPORARILY NOT AVAILABLE,       00018100
*                                      READ REQUESTS SHOULD BE  02S0043 00018200
*                                      DIRECTED TO DUPLEX DATA SET      00018300
*                                      0=NORMAL PROCESSING IN EFFECT */ 00018400
*         5 * BIT(5),               /* UNUSED                        */ 00018500
*       3 PARENN FIXED(15),         /* PART NUMBER FOR THIS PARTE    */ 00018600
*       3 PAREIOEQ PTR(31),         /* ADDRESS OF FIRST IOE ON  02S0043 00018700
*                                      UNSORTED READ QUEUE           */ 00018800
*       3 PARESZSL FIXED(31),       /* SIZE OF PAGE DATA SET IN 02S0043 00018900
*                                      NUMBER OF SLOTS               */ 00019000
*       3 PARESLTA FIXED(31),       /* NUMBER OF SLOTS AVAILABLE FOR    00019100
*                                      ALLOCATION                    */ 00019200
*       3 PARERRCT FIXED(31),       /* COUNT OF THE NUMBER OF   02S0043 00019300
*                                      PERMANENT I/O ERRORS SUFFERED    00019400
*                                      ON THIS PAGE DATA SET.        */ 00019500
*       3 PAREIORB PTR(31),         /* POINTER TO FIRST IORB FOR THIS   00019600
*                                      PAGE DATA SET                 */ 00019700
*       3 PAREPATP PTR(31),         /* POINTER TO PAT FOR THIS PAGE     00019800
*                                      DATA SET                      */ 00019900
*       3 PAREPCTP PTR(31),         /* POINTER TO PCT FOR THIS PAGE     00020000
*                                      DATA SET TYPE                 */ 00020100
*       3 PAREEDBP PTR(31),         /* POINTER TO EDP FOR PAGE DATA     00020200
*                                      SET                           */ 00020300
*       3 PAREUCBP PTR(31),         /* POINTER TO UCB FOR PAGE DATA     00020400
*                                      SET                           */ 00020500
*/* THE FOLLOWING ARE UNIQUE FOR THE PARTE                           */ 00020600
*                                                               02S0043 00020700
*       3 PARENODE PTR(31),         /* SORTED READ QUEUE OF IOE'S       00020800
*                                      THIS FIELD IS ANCHOR FOR 02S0043 00020900
*                                      SORTED TREE OF IOE'S USED BY     00021000
*                                      SLOT SORT                     */ 00021100
*       3 PAREWTQE PTR(31),         /* POINTER TO WRITE Q FOR THIS      00021200
*                                      PARTE                         */ 00021300
*       3 PARERQTM FIXED(31),       /* CORRECTION VALUE, USED IN        00021400
*                                      COMPUTING SERVICE BURST FOR      00021500
*                                      THIS PAGE DATA SET            */ 00021600
*       3 PARELCYL FIXED(15),       /* LAST RELATIVE CYLINDER ON THIS   00021700
*                                      PAGE DATA SET PROCESSED BY       00021800
*                                      SLOT SORT                     */ 00021900
*       3 * CHAR(2);                /* RESERVED                      */ 00022000
