*   DECLARE                                                     02S0042 00005800
*     1 PART BASED(PARTPTR) BDY(DWORD),/* PAGING ACTIVITY REFERENCE     00005900
*                                      TABLE                         */ 00006000
*       3 PARTHDR CHAR(80) BDY(DWORD),/* PART HEADER WHICH CONTAINS     00006100
*                                      GENERAL INFORMATION ABOUT THE    00006200
*                                      PAGE DATA SETS                */ 00006300
*         5 PARTIDEN CHAR(4),       /* 'PART' IDENTIFIER             */ 00006400
*         5 PARTSIZE FIXED(31),     /* THE TOTAL NUMBER OF PART 02S0042 00006500
*                                      ENTRIES (PARTE'S) CONTAINED IN   00006600
*                                      THIS PART                     */ 00006700
*         5 PARTEUSE FIXED(31),     /* NUMBER OF PARTE'S IN USE      */ 00006800
