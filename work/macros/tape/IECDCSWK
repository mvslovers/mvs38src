CSCRWKA  DSECT                                                          00950064
CSCRWSRB DS    CL44          SRB TO SCHEDULE IECVIRST/IECVRSTI @ZM49596 01000064
*                             NOTE: THIS MUST BE FIRST IN      @ZM49377 01010064
*                                   CSCRWKA                    @ZM49377 01040064
         DS    0F                                                       01070064
CSCRCSID DS    H              CHANNEL SET ON WHICH FAILURE OCCURRED     01100064
CSCRWLOC DS    C              SRB SCHEDULE LOCK (FOR TEST & SET)        01130064
CSCRFLG0 DS    C              RECOVERY STATUS FLAG BYTE                 01160064
CSCRWXDM EQU   X'80'          MORE CHANNELS LOST ON THIS CHANNEL SET    01250064
*                             WHILE RECOVERY WAS IN EXECUTION           01300064
CSCRWRUN EQU   X'20'          RECOVERY IS IN EXECUTION.                 01380064
CSCRSETD EQU   X'10'          A SETDIE HAS BEEN ISSUED. RECOVERY WILL   01410064
*                             CONTINUE WHEN TIME INTERVAL HAS EXPIRED.  01440064
CSCRSCHD EQU   X'08'          THE TIME INTERVAL HAS EXPIRED. AN SRB     01470064
*                             HAS BEEN SCHEDULED TO CONTINUE RECOVERY   01500064
CSCRSTSM DS    C              USED FOR STNSM/STOSM BY RECOVERY.         01530064
         DS    CL3            RESERVED                                  01539064
         DS    F              RESERVED                                  01620064
CSCRWKAL EQU   *-CSCRWKA      LENGTH OF CHANNEL RECOVERY WORK AREA      01630064
         SPACE                                                          01640064
CSCRWA   DSECT                CHANNEL SET CHANNEL RECOVERY WORK AREA    01650064
CSCRIRST DS    CL(CSCRWKAL)   IECVIRST CHANNEL RECOVERY WORK AREA       01660064
*                             CSCRIRST IS AVAILABLE WHEN       @ZM49377 01670064
*                             CSCRWLOC = 0 AND CSCRWRUN = 0.   @ZM49377 01680064
CSCRRSTI DS    CL(CSCRWKAL)   IECVRSTI CHANNEL RECOVERY WORK AREA       01690064
*                             CSCRRSTI IS AVAILABLE WHEN       @ZM49377 01700064
*                             CSCRWLOC = 0.                    @ZM49377 01710064
CSCRCCH  DS    CL(CSCRWKAL)   CCH CHANNEL RECOVERY WORK AREA            01720064
*                             CSCRCCH IS AVAILABLE WHEN        @ZM49377 01730064
*                             CSCRWLOC = 0.                    @ZM49377 01740064
         MEND                                                           01800064
