         MACRO
         IEAPPNIP &WTOHDR=NO,&WTORLST=NO,&SPE=NO,&MNTPL=NO,&OPNPL=NO,  X
               &SCHDL=NO,&PAHDR=NO,&PAREA=NO,&PARMTAB=NO,&PTE=NO
*/********************************************************************/
*/*                                                                  */
*/*                                                                  */
*/*                                                                  */
*/********************************************************************/
*/*      %INCLUDE SYSLIB(IEAPMNIP)                                   */
*                                                                  0128
         AIF   ('&WTOHDR' EQ 'NO').SKIPIT1
*   /*****************************************************************/
*   /*                                                               */
*   /* ** NIPWTO MESSAGE HEADER THE FOLLOWING STRUCTURE MAPS THE     */
*   /* NIPWTO MESSAGE HEADER THAT IS GENERATED BY THE BAL MACRO      */
*   /* -IEAPMNIP TYPE=HEADER- AND IS USED TO PASS INFORMATION TO THE */
*   /* NIPWTO SERVICE ROUTINE. THE MESSAGE LENGTH FIELD, NWTOLNG,    */
*   /* INCLUDES THE LENGTH OF THE MESSAGE HEADER ITSELF.             */
*   /*                                                               */
*   /*****************************************************************/
*                                                                  0128
*   DECLARE                                                        0128
*     1 NWTOHDR BASED,              /* MESSAGE HEADER START          */
NWTOHDR  DSECT
*      2 NWTOLNG FIXED(15),         /* MESSAGE LENGTH                */
NWTOLNG  DS    Y
*      2 NWTOFL CHAR(2),            /* NIP MESSAGE FLAGS             */
NWTOFL   DS    X
*       3 NWTOFLNH BIT(1),          /* NOT TO BE HARDCOPIED          */
NWTOFLNH EQU   X'80'
*       3 NWTOFLNC BIT(1),          /* SUPRESS BLANK COMPRESS        */
NWTOFLNC EQU   X'40'
*       3 * BIT(14);                /* RESERVED                      */
.SKIPIT1 ANOP  ,
         AIF   ('&WTORLST' EQ 'NO').SKIPIT2
*                                                                  0128
*   /*****************************************************************/
*   /*                                                               */
*   /* ** END OF NIPWTO MESSAGE HEADER ** NIPWTOR PARAMETER LIST THE */
*   /* FOLLOWING STRUCTURE MAPS THE NIPWTOR PARAMETER LIST THAT IS   */
*   /* GENERATED BY THE BAL MACRO -IEAPMNIP TYPE=PLIST- AND IS USED  */
*   /* TO PASS INFORMATION TO THE NIPWTOR SERVICE ROUTINE.           */
*   /*                                                               */
*   /*****************************************************************/
*                                                                  0129
*   DECLARE                                                        0129
*     1 NWTORLST BASED,             /* PARM LIST START               */
NWTORLST DSECT
*      2 NWTORRPA PTR(31),          /* REPLY AREA ADDRESS            */
NWTORRPA DS    F
*      2 NWTORECB PTR(31),          /* REPLY ECB ADDRESS             */
NWTORECB DS    F
*      2 NMTORRDL FIXED(15),        /* REPLY AREA LENGTH             */
NMTORRDL DS    H
*      2 NWTORFL CHAR(1),           /* NIP WTOR FLAGS                */
NWTORFL  DS    X
*       3 NWTORFLA BIT(1),          /* ASYNCHRONOUS REQUEST          */
NWTORFLA EQU   X'80'
*       3 * BIT(3),                 /* RESERVED                      */
*       3 NWTORFLB BIT(1),          /* PROVIDE SQA BUFFER            */
NWTORFLB EQU   X'08'
*       3 * BIT(3),                 /* RESERVED                      */
*      2 * CHAR(1),                 /* RESERVED                      */
         DS    X
*      2 NWTORMSG PTR(31);          /* WTOR MESSAGE HEADER ADDRESS.  */
NWTORMSG DS    H
.SKIPIT2 ANOP  ,
         AIF   ('&SPE' EQ 'NO').SKIPIT3
*                                                                  0129
*   /*****************************************************************/
*   /*                                                               */
*   /* ** END OF NIPWTOR PARAMETER LIST ** NIP SYSTEM PARAMETER QUEUE*/
*   /* ENTRY THE FOLLOWING STRUCTURE MAPS THE NIP SYSTEM PARAMETER   */
*   /* ENTRY WHICH IS AN INTERNAL CONTROL BLOCK USED BY NIP TO TRACK */
*   /* SQA BUFFERS USED TO CONTAIN WTOR REPLIES. THIS IS DONE SO THAT*/
*   /* IEAVNIPX CAN FREE THESE AREAS AT THE END OF NIP PROCESSING.   */
*   /* ONE SPE IS CONTAINED IN THE NVTSPE FIELD OF THE NVT. IF OTHERS*/
*   /* ARE REQUIRED, THEY ARE OBTAINED DYNAMICALLY FROM SQA AND      */
*   /* CHAINED TO THE ONE IN THE NVT.                                */
*   /*                                                               */
*   /*****************************************************************/
*                                                                  0130
*   DECLARE                                                        0130
*     1 NIPSPE BASED,               /* NIPSPE START                  */
NIPSPE   DSECT
*      2 NIPSPEQ PTR(31),           /* CHAIN PTR                     */
NIPSPEQ  DS    F
*      2 NIPSPEA PTR(31);           /* PARAMETER PTR                 */
NIPSPEA  DS    F
.SKIPIT3 ANOP  ,
         AIF   ('&MNTPL' EQ 'NO').SKIPIT4
*                                                                  0130
*   /*****************************************************************/
*   /*                                                               */
*   /* ** END OF NIPSPE ** NIPMOUNT PARAMETER LIST THE FOLLOWING     */
*   /* STRUCTURE MAPS THE NIPMOUNT PARAMETER LIST THAT IS GENERATED  */
*   /* BY THE BAL MACRO -IEAPMNIP TYPE=MOUNTPL AND IS USED TO PASS   */
*   /* INFORMATION TO THE NIPMOUNT SERVICE ROUTINE. THIS MAPPING MUST*/
*   /* BE INCLUDED IN ANY MODULE THAT USES THE NIPMOUNT SERVICE,     */
*   /* SINCE IT IS REFERRED TO BY THE NIPMOUNT BAL CALL MACRO,       */
*   /* IEAPMNIP TYPE=MOUNT.                                          */
*   /*                                                               */
*   /*****************************************************************/
*                                                                  0131
*   DECLARE                                                        0131
*     1 NIPMNTPL BASED,             /* PARM LIST START               */
NIPMNTPL DSECT
*      2 NMNTDS CHAR(12),           /* DATASET NAME OR               */
NMNTDSA  DS    0A
NMNTDS   DS    CL12
*       3 NMNTDSA PTR(31) BDY(BYTE),/* DS NAME ADDRESS               */
*      2 NMNTVS CHAR(6),            /* VOLUME SERIAL OR              */
NMNTUCB  DS    0A
NMNTVS   DS    CL6
*       3 NMNTUCB FIXED(31) BDY(BYTE),/* UCB ADDRESS                 */
*      2 NMNTDT CHAR(2),            /* DEVICE TYPE                   */
NMNTDT   DS    XL2
*      2 NMNTFL CHAR(1),            /* NIPMOUNT FLAGS                */
NMNTFL   DS    X
*       3 * BIT(4),                 /* ** RESERVED **                */
*       3 NMNTFUS BIT(1),           /* UCB SCAN ONLY REQUEST         */
NMNTFUS  EQU   X'08'
*       3 NMNTFLI BIT(1),           /* DS NAME ADDR GIVEN            */
NMNTFLI  EQU   X'04'
*       3 NMNTFLC BIT(1),           /* CONDITIONAL REQUEST           */
NMNTFLC  EQU   X'02'
*       3 NMNTFLB BIT(1),           /* UCB ADDRESS GIVEN             */
NMNTFLB  EQU   X'01'
*      2 * CHAR(3);                 /* ** RESERVED **                */
         DS    XL3
.SKIPIT4 ANOP  ,
         AIF   ('&OPNPL' EQ 'NO').SKIPIT5
*                                                                  0131
*   /*****************************************************************/
*   /*                                                               */
*   /* ** END OF NIPMOUNT PARAMETER LIST ** NIPOPEN PARAMETER LIST   */
*   /* THE FOLLOWING STRUCTURE MAPS THE NIPOPEN PARAMETER LIST THAT  */
*   /* IS GENERATED BY THE BAL MACRO -IEAPMNIP TYPE=OPENPL- AND IS   */
*   /* USED TO PASS INFORMATION TO THE NIPOPEN SERVICE ROUTINE. THIS */
*   /* MAPPING MUST BE INCLUDED IN ANY MODULE THAT USES THE NIPOPEN  */
*   /* SERVICE, SINCE IT IS REFERRED TO BY THE NIPOPEN BAL CALL      */
*   /* MACRO, IEAPMNIP TYPE=OPEN.                                    */
*   /*                                                               */
*   /*****************************************************************/
*                                                                  0132
*   DECLARE                                                        0132
*     1 NIPOPNPL BASED,             /* PARM LIST START               */
NIPOPNPL DSECT
*      2 NOPNDS CHAR(12),           /* DATASET NAME OR               */
NOPNDSA  DS    0A
NOPNDS   DS    CL12
*       3 NOPNDSA PTR(31) BDY(BYTE),/* DS NAME ADDRESS               */
*      2 NOPNDCB PTR(31),           /* DCB ADDRESS                   */
NOPNDCB  DS    A
*      2 NOPNUCB PTR(32),           /* UCB ADDRESS           @Z30AAXC*/
NOPNUCB  DS    A
*      2 NOPNFL CHAR(1),            /* NIPOPEN FLAGS                 */
NOPNFL   DS    X
*       3 NOPNFRS BIT(1),           /* PERMANENTLY RESIDENT DS       */
NOPNFRS  EQU   X'80'
*       3 NOPNFAU BIT(1),           /* AUTHORIZED LIBRARY FLAG       */
NOPNFAU  EQU   X'40'
*       3 NOPNFLM BIT(1),           /* SUPRESS DS NOT FOUND MSG      */
NOPNFLM  EQU   X'20'
*       3 NOPNFLI BIT(1),           /* DS NAME ADDR GIVEN            */
NOPNFLI  EQU   X'10'
*       3 NOPNFLNB BIT(1),          /* INITIALIZE BASIC DEB          */
NOPNFLNB EQU   X'08'
*       3 NOPNFLLB BIT(1),          /* END OF NUCLEUS DEB            */
NOPNFLLB EQU   X'04'
*       3 NOPNFLLC BIT(1),          /* CONDITIONAL REQUEST           */
NOPNFLLC EQU   X'02'
*       3 NOPNFLSX BIT(1),          /* FIRST EXTENT ONLY             */
NOPNFLSX EQU   X'01'
*      2 NOPNRC CHAR(1),            /* NIPOPEN RETURN CODE           */
NOPNRC   DS    X
*      2 * CHAR(2);                 /* ** RESERVED **                */
         DS    XL2
.SKIPIT5 ANOP  ,
         AIF   ('&SCHDL' EQ 'NO').SKIPIT6
*                                                                  0132
*   /*****************************************************************/
*   /*                                                               */
*   /* ** END OF NIPOPEN PARAMETER LIST ** NIPSCHED PARAMETER LIST   */
*   /* THE FOLLOWING STRUCTURE MAPS THE NIPSCHED PARAMETER LIST THAT */
*   /* IS GENERATED BY THE BAL MACRO -IEAPMNIP TYPE=SCHEDL- AND IS   */
*   /* USED TO PASS INFORMATION TO THE NIPSCHED SERVICE ROUTINE.     */
*   /*                                                               */
*   /*****************************************************************/
*                                                                  0133
*   DECLARE                                                        0133
*     1 NIPSCHDL BASED,                                            0133
NIPSCHDL DSECT
*      2 NSCHDPTR PTR(31),          /* ADDRESS OF ROUTINE TO SCHED   */
NSCHDPTR DS    A
*      2 NSCHDPRM PTR(31),          /* ADDRESS OF CALLERS AREA       */
NSCHDPRM DS    A
*      2 NSCHDCPU CHAR(2);          /* CPU ADDRESS FOR SCHEDULE      */
NSCHDCPU DS    XL2
*                                                                  0133
*   /*****************************************************************/
*   /*                                                               */
*   /* **** END OF NIPSCHED PARAMETER LIST                           */
*   /*                                                               */
*   /*****************************************************************/
*                                                                  0134
.SKIPIT6 ANOP  ,
         AIF   ('&PAHDR' EQ 'NO').SKIPIT7
*                                                                  0134
*/********************************************************************/
*/*                                                                  */
*/*      INCLUDE NIP PARAMETER AREA AND PARAMETER TABLE DSECTS       */
*/*                                                                  */
*/********************************************************************/
*/*      %INCLUDE SYSLIB(IEAPPNIP)                                   */
*/*  *****************************************************************/
*/*                          I E A P P N I P                         */
*/*     MAPPING OF NIP PARAMETER AREA AND PARAMETER ADDRESS TABLE    */
*/*                                                                  */
*/*                     DATE=05/22/74,VS2-3 VERSION                  */
*/*                                                                  */
*/*  *****************************************************************/
*/*  *****          NIP  PARAMETER  AREA  (NIPPAREA)            ******/
*/*   PARAMETER AREA HEADER                                          */
*                                                                  0134
*   DECLARE                                                        0134
*     1 NIPPAHDR CHAR(8) BDY(DWORD) BASED,                         0134
NIPPAHDR DSECT
*      2 NIPPAQ PTR(31),            /* CHAIN PTR TO NEXT ON QUEUE    */
NIPPAQ   DS    A
*      2 NIPPABYT PTR(31);          /* PTR - NEXT AVAIL. BYTE        */
NIPPABYT DS    A
.SKIPIT7 ANOP  ,
         AIF   ('&PAREA' EQ 'NO').SKIPIT8
*                                                                  0135
*/*   PARAMETER AREA                                                 */
*                                                                  0135
*   DECLARE                                                        0135
*     1 NIPPAREA BDY(DWORD) BASED,  /* PARAMETER AREA BEGINNING      */
NIPPAREA DSECT
*      2 * CHAR(LENGTH(NIPPAHDR)),  /* PARMAREA HEADER               */
         DS    2A
*                                                                  0135
*     /***************************************************************/
*     /*                                                             */
*     /* HERE BEGINS: FOR INITIAL PARMAREA - INITIAL FIELDS FOR OTHER*/
*     /* PARMAREAS - RECORD BUFFER AREA                              */
*     /*                                                             */
*     /***************************************************************/
*                                                                  0135
*      2 NIPPARC FIXED(31),         /* RETURN CODE FROM IEAPSPIO     */
NIPPARC  DS    A
*      2 NIPPABDL CHAR(18),         /* PARMLIB BLDL ENTRY            */
NIPPABDL DS    0XL18
*       3 NIPPABDH CHAR(4),         /* BLDL HEADER                   */
NIPPABDH DS    0XL4
*        4 NIPPA2BF CHAR(1),        /* BEGINNING OF BUFFER AREA      */
NIPPA2BF DS    X
         DS    XL3
*       3 NIPPANAM CHAR(8),         /* PARMLIB MEMBER NAME           */
NIPPANAM DS    CL8
*       3 NIPPATTR CHAR(3),         /* MEMBER TTR ENTRY              */
NIPPATTR DS    XL3
*       3 * CHAR(3),                /* * RESERVED FOR BLDL ENTRY *   */
         DS    XL3
*      2 * CHAR(2),                 /* UNASSIGNED                    */
         DS    XL2
*      2 NIPPAIOD CHAR(216) BDY(DWORD),/* I/O DATA AREA              */
NIPPAIOD DS    0XL216
*       3 NIPPATXT CHAR(32),        /* CCW'S - READ TEXT RECORDS     */
NIPPATXT DS    XL32
*       3 NIPPASID CHAR(5),         /* SEARCH ID FOR NEXT TEXT RCD   */
NIPPASID DS    XL5
*       3 * CHAR(3),                /* ** UNASSIGNED **              */
         DS    XL3
*       3 NIPPAIOB CHAR(40),        /* PARMLIB IOB                   */
NIPPAIOB DS    XL40
*       3 NIPPADCB CHAR(4),         /* PARMLIB DCB                   */
NIPPADCB DS    A
*       3 NIPPAECB CHAR(4),         /* PARMLIB ECB                   */
NIPPAECB DS    0F
*        4 NIPPAECC CHAR(1),        /* - PARMLIB ECB CONDITION CODE  */
NIPPAECC DS    X
*        4 * CHAR(3),               /* - REST OF PARMLIB ECB         */
         DS    XL3
*       3 NIPPADEB CHAR(48),        /* PARMLIB DEB                   */
NIPPADEB DS    XL48
*       3 NIPPARCD CHAR(80),        /* READ AREA FOR PARMLIB RCDS    */
NIPPARCD DS    XL80
*      2 * CHAR(4),                 /* UNASSIGNED                    */
         DS    XL4
*      2 NIPPAPTB CHAR(296),        /* PARAMETER ADDR TABLE          */
NIPPAPTB DS    XL320                PARMTABF - PARAMETER ADDR TABLE
*      2 NIPPABUF CHAR(1);          /* BEGIN INITIAL PARMAREA BUFFER */
NIPPABUF DS    X
*/*  *****             END  OF  NIP  PARAMETER  AREA            ******/
*/*  *****             NIP  PARAMETER  ADDRESS  TABLE           ******/
.SKIPIT8 ANOP  ,
         AIF   ('&PARMTAB' EQ 'NO').SKIPIT9
*                                                                  0136
*/*   PARAMETER ADDRESS TABLE -                                      */
*                                                                  0136
*   DECLARE                                                        0136
*     1 PARMTAB BASED,              /* BEGIN PARAMETER ADDRESS TAB   */
PARMTABF DSECT
*      2 PTABSTRT CHAR(8),          /* DUMMY HEADER                  */
PTABSTRT DS    CL8
*      2 APF PTR(31),               /* AUTHORIZED PROG. LIBRARIES    */
APF      DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 APG PTR(31),               /* AUTO. PRIORITY GROUP          */
APG      DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 BLDL PTR(31),              /* PARMLIB MEMBER FOR BLDL       */
BLDL     DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 BLDLF PTR(31),             /* FIXED BLDL LIST               */
BLDLF    DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 CLPA PTR(31),              /* CREATE LINK PACK AREA         */
CLPA     DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 CMD PTR(31),               /* CANNED OPERATOR COMMANDS      */
CMD      DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 CONT PTR(31),              /* LINE CONTINUATION             */
CONT     DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 CPQE PTR(31),              /* CHANNEL PROG QUEUE EXTENSION  */
CPQE     DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 CSA PTR(31),               /* COMMON SERVICE AREA SIZE      */
CSA      DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 CVIO PTR(31),              /* WARM START VAM DATA SETS      */
CVIO     DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 DUMP PTR(31),              /* TAPE FOR SYS1.DUMP            */
DUMP     DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 FIX PTR(31),               /* ROUTINES IN FIXED LPA EXTN    */
FIX      DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 HARDCPY PTR(31),           /* HARDCOPY LOG                  */
HARDCPY  DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 IPS PTR(31),               /* OPTIMIZER IPS GROUP           */
IPS      DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 LNK PTR(31),               /* LNKLSTXX VALUES               */
LNK      DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 LOGCLS PTR(31),            /* LOG CLASS VALUES              */
LOGCLS   DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 LOGLMT PTR(31),            /* LOG LIMIT VALUES              */
LOGLMT   DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 MAXUSER PTR(31),           /* MAXIMUM NO. OF ADDRESS SPACES */
MAXUSER  DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 MLPA PTR(31),              /* ROUTINES IN LPA EXTENSION     */
MLPA     DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 NUCMAP PTR(31),            /* BUILD ANOTHER NUCMAP FOR DSS  */
NUCMAP   DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 OPI PTR(31),               /* OPERATOR INTERVENTION         */
OPI      DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 OPT PTR(31),               /* OPTIMIZER TUNING PARAMETERS   */
OPT      DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 PAGEP PTR(31),             /* PAGE DS PARMS - PARMLIB       */
PAGEP    DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 PAGEO PTR(31),             /* PAGE DS PARMS - OPERATOR      */
PAGEO    DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 REAL PTR(31),              /* V=R ADDRESS LIMIT             */
NREAL    DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 SMF PTR(31),               /* PTR TO SMF PARMLIB MEMBER     */
SMF      DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 SQA PTR(31),               /* SQA VIRTUAL SPACE             */
SQA      DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 SYSP PTR(31),              /* SYSTEM PARAMETER LIST         */
SYSP     DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 VAL PTR(31),               /* VOLUME ATTRIBUTE PROCESSING   */
VAL      DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 VRREGN PTR(31),            /* DEFAULT V=R SPACE ALLOCATED   */
VRREGN   DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 WTOBFRS PTR(31),           /* NUMBER OF WTO BUFFERS         */
WTOBFRS  DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 WTORPLY PTR(31),           /* WTOR REPLY BUFFER NUMBER      */
WTORPLY  DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID           */
         DS    XL4
*      2 PURGE PTR(31),             /* PURGE KEYWORD         @Y30LPXD*/
PURGE    DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID   @Y30LPXD*/
         DS    XL4
*      2 * CHAR(8),                 /* PARMLIB READ FLAGS    @Y30LPXD*/
         DS    0XL8
*       3 NIPPAFLG CHAR(1),         /* PARMLIB READ FLAGS    @Y30LPXD*/
NIPPAFLG DS    X
*        4 NIPPAFL1 BIT(1),         /* MEMBER NOT FOUND MSG SUPPRESS */
NIPPAFL1 EQU   X'80'
*        4 * BIT(7),                /* RESERVED              @Y30LPXD*/
*       3 * CHAR(7),                /* RESERVED              @Y30LPXD*/
         DS    CL7
*      2 RSU PTR(31),               /* RSU PARM PTR          @Y30LPXD*/
RSU      DS    A
*      2 * CHAR(4),                 /* FLAGS AND SOURCE ID   @Y30LPXD*/
         DS    XL4
SWAP     DS    A                    SWAP PARM PTR
         DS    XL4
PAGNUM   DS    A                    PAGNUM PARM PTR
         DS    XL4
DUPLEX   DS    A                    DUPLEX PARM PTR
         DS    XL4
*      2 PTABEND(2) PTR(31);        /* DUMMY TRAILER                 */
PTABEND  DS    2A
.SKIPIT9 ANOP  ,
         AIF   ('&PTE' EQ 'NO').SKIPITA
*                                                                  0137
*/*  *****        END  OF  NIP  PARAMETER  ADDRESS  TABLE       ******/
*/*  *****         NIP  PARAMETER  ADDRESS  TABLE  ENTRY        ******/
*/*   NIP PARMTAB ENTRY MAP                                          */
*                                                                  0137
*   DECLARE                                                        0137
*     1 NIPPTE BASED,               /* BEGIN PARMTAB ENTRY           */
NIPPTE   DSECT
*      2 NIPPTADR PTR(31),          /* PARAMETER ORIGIN ADDRESS      */
NIPPTADR DS    A
*      2 NIPPTOPF CHAR(1),          /* OPTION FLAGS BYTE             */
NIPPTOPF DS    X
*       3 NIPPTOPI BIT(1),          /* OPI OPTION                    */
NIPPTOPI EQU   X'80'
*       3 NIPPTLST BIT(1),          /* LIST REQUEST OPTION           */
NIPPTLST EQU   X'40'
*       3 NIPPTCAN BIT(1),          /* CANCEL REQUEST FLAG           */
NIPPTCAN EQU   X'20'
*       3 * BIT(5),                 /* ** UNASSIGNED **              */
*      2 NIPPTATF CHAR(1),          /* ATTRIBUTE FLAGS BYTE          */
NIPPTATF DS    X
*       3 NIPPTMRG BIT(1),          /* MERGE ATTRIBUTE               */
NIPPTMRG EQU   X'80'
*       3 * BIT(7),                 /* ** UNASSIGNED **              */
*      2 NIPPTSID CHAR(2);          /* INPUT SOURCE ID : X'0000' - 0137
NIPPTSID DS    CL2
*                                      OPERATOR C'XX' - PLIB MEMBER
*                                      SUFFIX                        */
*/*  *****    END OF NIP  PARAMETER  ADDRESS  TABLE  ENTRY      ******/
.SKIPITA ANOP  ,
         MEND
