)F FUNCTION -                                                           01000000
  THE LINK COMMAND IS USED TO INVOKE THE LINKAGE EDITOR WHICH WILL      02000000
  RESOLVE REFERENCES AND PRODUCE A LOAD MODULE.                         03000000
)X SYNTAX -                                                             04000000
         LINK   'DSLIST'  LOAD('DSNAME')  PRINT('DSNAME')/NOPRINT       05000000
                LIB('KWDSLIST')  COBLIB  PLILIB  FORTLIB  PLIBASE       06000000
                PLICMIX  MAP/NOMAP  XREF/NOXREF  LIST/NOLIST  LET/NOLET 07000000
                XCAL/NOXCAL  NCAL/NONCAL  SCTR/NOSCTR  OVLY/NOOVLY      08000000
                RENT/NORENT  REUS/NOREUS  REFR/NOREFR  NE/NONE  OL/NOOL 09000000
                DC/NODC  TEST/NOTEST  HIAR/NOHIAR  TERM/NOTERM          10000000
                DCBS('INTEGER')  SIZE('INTEGER1,INTEGER2')              12000000
                ALIGN2/NOALIGN2  AC(ACCESS CODE)                        12050000
  REQUIRED - 'DSLIST'                                                   13000000
  DEFAULTS - NOPRINT  NOMAP  NOXREF  NOLIST  NOLET  NOXCAL  NONCAL      14000000
             NOSCTR  NOOVLY  NORENT  NOREUS  NOREFR  NONE  NOOL  NODC   15000000
             NOTEST  NOHIAR  TERM    NOALIGN2                           16000000
)O OPERANDS -                                                           17000000
  'DSLIST' - LIST OF INPUT DATA SET NAMES.  AN '*' IN THE LIST WILL     18000000
             ALLOW LINKAGE EDITOR CONTROL STATEMENTS TO BE ENTERED FROM 19000000
             THE TERMINAL.                                              20000000
))LOAD('DSNAME')                                                        21000000
           - SPECIFIES NAME OF DATA SET INTO WHICH OUTPUT LOAD MODULE   22000000
             WILL BE WRITTEN.                                           23000000
))PRINT('DSNAME')                                                       24000000
           - LINKAGE EDITOR LISTINGS WILL BE PRODUCED.                  25000000
     'DSNAME'                                                           26000000
           - OPTIONAL PARAMETER TO SPECIFY A DATA SET TO BE USED FOR    27000000
             THE LISTINGS.  TO DISPLAY LISTINGS AT THE TERMINAL, CODE   28000000
             '*' FOR 'DSNAME'.                                          29000000
))NOPRINT  - NO LIKAGE EDITOR LISTINGS WILL BE PRODUCED.                30000000
))LIB('KWDSLIST')                                                       31000000
           - LIBRARIES WILL BE USED TO RESOLVE EXTERNAL REFERENCES.     32000000
     'KWDSLIST'                                                         33000000
           - LIST OF THE LIBRARY NAMES TO BE USED.                      34000000
))COBLIB   - SYS1.COBLIB WILL BE USED TO RESOLVE EXTERNAL REFERENCES.   35000000
))PLILIB   - SYS1.PL1LIB WILL BE USED TO RESOLVE EXTERNAL REFERENCES.   36000000
))FORTLIB  - SYS1.FORTLIB WILL BE USED TO RESOLVE EXTERNAL REFERENCES.  37000000
))PLIBASE  - SYS1.PLIBASE WILL BE USED TO RESOLVE EXTERNAL REFERENCES.  38000000
))PLICMIX  - SYS1.PLICMIX WILL BE USED TO RESOLVE EXTERNAL REFERENCES.  39000000
))MAP      - A LIST OF EXTERNAL NAMES AND THEIR LOCATIONS WILL BE       40000000
             WRITTEN ON THE PRINT DATA SET.                             41000000
))NOMAP    - A LIST OF EXTERNAL NAMES AND THEIR LOCATIONS WILL NOT BE   42000000
             PRODUCED.                                                  43000000
))XREF     - A LIST OF EXTERNAL NAMES AND THEIR LOCATIONS PLUS A CROSS  44000000
             REFERENCE LIST WILL BE WRITTEN ON THE PRINT DATA SET.      45000000
))NOXREF   - A CROSS REFERENCE LIST WILL NOT BE PRODUCED.               46000000
))LIST     - A LIST OF LINKAGE EDITOR CONTROL STATEMENTS WILL BE        47000000
             WRITTEN ON THE PRINT DATA SET.                             48000000
))NOLIST   - A LIST OF LINKAGE EDITOR CONTROL STATEMENTS WILL NOT BE    49000000
             PRODUCED.                                                  50000000
))LET      - LOAD MODULE WILL BE MARKED EXECUTABLE EVEN IF A SEVERITY 2 51000000
             ERROR OCCURRED.                                            52000000
))NOLET    - LOAD MODULE WILL BE MARKED NOT EXECUTABLE IF A SEVERITY 2  53000000
             ERROR OCCURRED.                                            54000000
))XCAL     - LOAD MODULE WILL BE MARKED EXECUTABLE IF VALID EXCLUSIVE   55000000
             CALLS ARE ENCOUNTERED.                                     56000000
))NOXCAL   - LOAD MODULE WILL BE MARKED NOT EXECUTABLE IF EXCLUSIVE     57000000
             CALLS ARE ENCOUNTERED.                                     58000000
))NCAL     - THE LINKAGE EDITOR WILL NOT RESOLVE ANY UNRESOLVED         59000000
             EXTERNAL REFERENCES.                                       60000000
))NONCAL   - THE LINKAGE EDITOR WILL TRY TO RESOLVE ANY UNRESOLVED      61000000
             EXTERNAL REFERENCES.                                       62000000
))SCTR     - LOAD MODULE WILL BE MARKED FOR SCATTER LOADING.            63000000
))NOSCTR   - LOAD MODULE WILL NOT BE MARKED FOR SCATTER LOADING.        64000000
))OVLY     - LOAD MODULE IS TO BE AN OVERLAY STRUCTURE.                 65000000
))NOOVLY   - LOAD MODULE IS NOT TO BE AN OVERLAY STRUCTURE.             66000000
))RENT     - LOAD MODULE IS TO BE MARKED REENTRABLE.                    67000000
))NORENT   - LOAD MODULE IS NOT TO BE MARKED REENTRABLE.                68000000
))REUS     - LOAD MODULE IS TO BE MARKED REUSABLE.                      69000000
))NOREUS   - LOAD MODULE IS NOT TO BE MARKED REUSABLE.                  70000000
))REFR     - LOAD MODULE IS TO BE MARKED REFRESHABLE.                   71000000
))NOREFR   - LOAD MODULE IS NOT TO BE MARKED REFRESHABLE.               72000000
))NE       - LOAD MODULE MAY  NEVER BE REPROCESSED BY THE LINKAGE       73000000
             EDITOR OR LOADER.                                          74000000
))NONE     - LOAD MODULE MAY BE REPROCESSED BY THE LINKAGE EDITOR OR    75000000
             LOADER.                                                    76000000
))OL       - LOAD MODULE MAY BE LOADED INTO CORE ONLY BY LOAD MACRO.    77000000
))NOOL     - LOAD MODULE LOADING NOT RESTRICTED TO LOAD MACRO.          78000000
))DC       - LOAD MODULE MAY BE REPROCESSED BY E-LEVEL LINKAGE EDITOR.  79000000
))NODC     - LOAD MODULE MAY NOT BE REPROCESSED BY THE E-LEVEL LINKAGE  80000000
             EDITOR.                                                    81000000
))TEST     - SYMBOL TABLES WILL BE TRANSFERRED TO LOAD MODULE.          82000000
))NOTEST   - SYMBOL TABLES WILL NOT BE TRANSFERRED TO LOAD MODULE.      83000000
))HIAR     - HIERARCHY ASSIGNMENTS FOR CSECTS MAY BE MADE.              84000000
))NOHIAR   - NO HIERARCHY ASSIGNMENTS FOR CSECTS WILL BE MADE.          85000000
))TERM     - LINKAGE EDITOR ERROR MESSAGES WILL BE DISPLAYED AT THE     86000000
             TERMINAL.                                                  87000000
))NOTERM   - LINKAGE EDITOR ERROR MESSAGES WILL NOT BE DISPLAYED AT THE 88000000
             TERMINAL.                                                  89000000
))DCBS('INTEGER')                                                       90000000
           - SPECIFIES BLOCKSIZE FOR LOAD MODULE DATA SET.              91000000
))SIZE('INTEGER1,INTEGER2')                                             92000000
           - SPECIFIES AMOUNT OF STORAGE TO BE USED BY LINKAGE EDITOR.  93000000
    'INTEGER1'                                                          94000000
           - TOTAL NUMBER OF BYTES USED BY LINKAGE EDITOR.              95000000
    'INTEGER2'                                                          96000000
           - NUMBER OF BYTES TO BE USED FOR LOAD MODULE BUFFERS.        97000000
))ALIGN2   - ALIGNS LOAD MODULE ON A 2K PAGE BOUNDARY.                  97050000
))AC('ACCESS CODE')                                                     97100000
           - UP TO 3 DECIMAL DIGITS FROM 0 TO 255 DEFINING THE ACCESS   97150000
             CODE ASSIGNED TO THE LOAD MODULE.                          97200000
