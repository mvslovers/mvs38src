  RESERVE VOLUMES FOR FUTURE USE BY VSAM.                               03000002
)X SYNTAX -                                                             04000002
         DEFINE    SPACE                                                05000002
                   (  VOLUMES('VOLSER' ...)                             06000002
                      TRACKS('PRIMARY' 'SECONDARY') |                   07000002
                         CYLINDERS('PRIMARY' 'SECONDARY') |             08000002
                         RECORDS('PRIMARY' 'SECONDARY')                 09000002
                            RECORDSIZE('AVERAGE' 'MAXIMUM') |           10000002
                         CANDIDATE                                      11000002
