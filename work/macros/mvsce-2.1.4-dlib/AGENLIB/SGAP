.*                                                                   *  02200064
.*       &I           - DEVICE POINTER                               *  02250064
.*                                                                   *  02300064
.* OUTPUT - THE FOLLOWING GLOBALS MAY BE SET BY THIS MACRO           *  02350064
.*                                                                   *  02400064
.*       &SGCPRGB(13) - POWER WARNING FEATURE SUPPORT REQUIRED       *  02450064
.*                                                                   *  02500064
.*       &SGDF08B(&I) - POWER WARNING FEATURE ON THIS DEVICE         *  02550064
.*                                                                   *  02600064
.*       &SGQUITB     - QUIT SWITCH - AN ERROR DETECTED              *  02610064
.*                                                                   *  02620064
.* EXIT, NORMAL - N/A                                                *  02650064
.*                                                                   *  02700064
.* EXIT, ERROR - N/A                                                 *  02750064
.*                                                                   *  02800064
.* EXTERNAL REFERENCES - N/A                                         *  02850064
.*                                                                   *  02900064
.* MACROS      - NONE                                                *  02950064
.*                                                                   *  03000064
.* CHANGE ACTIVITY - N/A                                             *  03050064
.*                                                                   *  03100064
.*********************************************************************  03150064
&I       SETA  &SGCNTRA(3)              GET DEVICE POINTER              03200064
         AIF   ('&SGAPPMC' NE 'YES').MEND  AP-YES SPECIFIED             03250064
         AIF   ('&PERMIT' NE 'YES').NOTPER  AP=YES NOT VALID            03300064
.* AP=PERMITTED FOR DEVICE                                              03350064
&SGCPRGB(13) SETB  1                    AP SUPPORT REQUIRED             03400064
&SGDF08B(&I) SETB  1                    AP FEATURE                      03450064
    MNOTE *,'    AP SUPPORTED FOR THIS &UNIT'                           03500064
         AGO   .MEND                                                    03550064
.*                                                                      03600064
.NOTPER  ANOP                           AP=YES NOT VALID                03650064
     MNOTE 5,'* * * IEIIOD203 AP INVALID FOR &ID&UNIT'                  03700064
&SGQUITB SETB  1                                                        03750064
.MEND    MEND                                                           03800064
