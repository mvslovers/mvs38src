&NUCM    SETC 'USRDDT00,IECVXDAS,IECVXDAT,IECVXDAU,IECVOTBL'     MVS38J 03200038
         SGDITGBL NUCDLB=AOSC5,SENSE=32,ERPMOD=IECLMSGD,         MVS38J+03300038
               ERPDLB=AOSC5,                                     MVS38J+03400038
               STATBL=0,PREFTBL=290,                             MVS38J+03500038
               DDTMOD=UDDT3380,                                  MVS38J+03600038
               NUCMOD=&NUCM,                                     MVS38J+03700038
               UCBTYPE=3010200E,GENERIC=3380                     MVS38J 03800038
.EXIT001 ANOP                                                    MVS38J 03900038
         MEXIT                                                   MVS38J 04000038
         MEND                                                    MVS38J 04100038
