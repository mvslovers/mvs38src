.*                    IODEVICE                                          01900064
.*                    UNITNAME                                          01950064
.*                                                                      02000064
.* MODULE TYPE - MACRO                                                  02050064
.*                                                                      02100064
.* ENTRY POINT - N/A                                                    02150064
.*                                                                      02200064
