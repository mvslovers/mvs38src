         PUNCH ' SELECT MEMBER=(IGG0197B) '                             00450003
.NX1     ANOP                                                           00550003
         AIF   (NOT (&SGDCLSB(78) OR &SGDCLSB(79))).NX5                 01050003
         PUNCH ' COPY OUTDD=LPALIB,INDD=AOSD0 '                  Y02898 01100003
         PUNCH ' SELECT MEMBER=(IGG0197L,IGG0197M,IGG0197N) '           01150003
         PUNCH ' SELECT MEMBER=(IGG0197P,IGG0197Q,IGG019FK) '           01200003
         PUNCH ' SELECT MEMBER=(IGG019FQ,IGG019FU,IGG019FA) '           01250003
         PUNCH ' SELECT MEMBER=(IGG0201P,IGG0201R) '             Y02898 01300003
.NX5     ANOP                                                           01350003
