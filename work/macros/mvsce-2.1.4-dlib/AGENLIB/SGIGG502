         PUNCH ' COPY OUTDD=LPALIB,INDD=AOSD0 '                  XM4256 01358003
         PUNCH ' SELECT MEMBER=(IGG019UM,IGG019UN,IGG019UO) '    XM4256 01361003
         PUNCH ' SELECT MEMBER=(IGG0197V) '                      XM4256 01364003
.NX6     ANOP                                                    XM4256 01367003
         AIF (NOT(&SGDCLSB(87))).NX7                             XM4256 01370003
         PUNCH ' COPY OUTDD=LPALIB,INDD=AOSD0 '                  XM4256 01373003
         PUNCH ' SELECT MEMBER=(IGG019LS,IGG019LT,IGG019LU) '    XM4256 01376003
         PUNCH ' SELECT MEMBER=(IGG0196R) '                      XM4256 01379003
.NX7     ANOP                                                    XM4256 01382003
         AIF (NOT(&SGDCLSB(86) OR &SGDCLSB(87))).NX8             XM4256 01385003
         PUNCH ' COPY OUTDD=LPALIB,INDD=AOSD0 '                  XM4256 01388003
         PUNCH ' SELECT MEMBER=(IGG08108) '                      XM4256 01391003
.NX8     ANOP                                                    XM4256 01394003
