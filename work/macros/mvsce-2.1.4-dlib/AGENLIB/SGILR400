         MACRO                                                          01000000
         SGILR400                                                       02000000
.*A-000000-999999                                               @Y026SG 03000000
.* /* START OF SPECIFICATIONS ****                                      04000000
.*                                                                      05000000
.*01  MODULE-NAME = SGILR400                                            06000000
.*                                                                      07000000
.*01  DESCRIPTIVE-NAME = ASM LINKLIB SYSGEN MACRO                       08000000
.*                                                                      09000000
.*01  STATUS = OS/VS2 RELEASE 4.1                                       10000040
.*                                                                      11000000
.*01  FUNCTION = SGILR400 CAUSES CERTAIN ASM PROGRAM MODULES TO BE      12000000
.*               LINK-EDITED INTO THE TARGET SYS1.LINKLIB               13000000
.*               FROM THE SYSGEN DISTRIBUTION LIBRARY SYS1.AOSC5.       14000000
.*                                                                      15000000
.*01  OPERATION = VIA THE ASSEMBLER PUNCH COMMAND, LINKAGE EDITOR       16000000
.*                CONTROL STATEMENTS ARE GENERATED FOR EACH MODULE.     17000040
.*                                                                      18000000
.*01  MODULE-TYPE = MACRO                                               19000000
.*02    PROCESSOR = ASSEMBLER XF                                        20000000
.*02    MACRO-SIZE = 38 STATEMENTS                                      21000040
.*                                                                      22000000
.*01  OUTPUT = LINKAGE EDITOR JCL AND CONTROL STATEMENTS                23000000
.*                                                                      24000000
.*01  INNER-MACRO = SGGBLPAK - DEFINE SYSTEM GLOBALS                    25000000
.*                  SGLEDPK1 - GENERATE LINKEDIT JCL                    26000000
.*                  SGLEDPK2 - GENERATE LINKEDIT SYSIN JCL              27000000
.*                                                                      28000000
.*01  MESSAGES = NONE                                                   29000000
.*                                                                      30000000
.**** END OF SPECIFICATIONS ***/                                        31000000
         COPY  SGGBLPAK           DEFINE SYSTEM GLOBAL VARIABLES        32000000
&SGCTRLC(7)    SETC '&SGCTRLC(32)'     SYSLMOD VOLUME                   33000000
&SGCTRLC(8)    SETC '&SGCTRLC(31)'     SYSLMOD UNIT                     34000000
&SGCTRLC(9)    SETC 'LINKLIB'          SYSLMOD DSNAME                   35000000
&SGCTRLC(10)   SETC ',RENT'                                             36000000
&SGCTRLC(11)   SETC ',REFR'                                             37000000
         COPY  SGLEDPK1           GENERATE LINK EDIT STEP               38000000
 PUNCH '//AOSC5 DD DSNAME=SYS1.AOSC5,VOLUME=(,RETAIN),DISP=SHR'         39000000
         COPY  SGLEDPK2           LINK EDIT SYSIN STAGE                 40000000
 PUNCH ' INCLUDE AOSC5(ILROPS00)'                             @Z40WPWN  41000040
