.*                                                                      03400002
.*                LABEL IECSCRWA EP,F4,D1=(N),D2=(N),ADT=YES            03450002
.*                                                                      03500002
.*      INPUT =                                                         03550002
.*                                                                      03600002
.*                OPTIONAL LABEL SPECIFIED AS AN ACCEPTABLE ASSEMBLER   03650002
.*                LABEL WHICH CAN BE USED BY THE CALLING CSECT TO       03700002
.*                ESTABLISH ADDRESSABILITY TO THE ENTIRE WORK AREA.     03750002
.*                                                                      03800002
.*                EP IS THE FIRST POSITIONAL PARAMETER, SPECIFYING      03850002
.*                THAT THE LABELS FOR EACH OF THE FIELDS IN THE 8       03900002
.*                WORD PREFIX, THE 20 WORD EXTENDED PREFIX, AND THE 4   03950002
.*                WORD DADSM WTG TABLE ARE TO BE EXPANDED.  IF THESE    04000002
.*                FIELDS ARE NOT TO BE DEFINED, A COMMA MUST BE CODED   04050002
.*                TO INDICATE THE ABSENCE OF THIS PARAMETER.            04100002
.*                                                                      04150002
.*                F4 IS THE SECOND POSITIONAL PARAMETER, SPECIFYING     04200002
.*                THAT THE FIELDS OF THE FORMAT 4 DSCB ARE TO BE        04250002
.*                EXPANDED USING THE IECSDSL1 DSCB MAPPING MACRO.       04300002
.*                IF THESE FIELDS ARE NOT TO BE DEFINED AND A           04350002
.*                KEYWORD PARAMETER FOLLOWS, A COMMA MUST BE            04400002
.*                CODED TO INDICATE THE ABSENCE OF THIS PARAMETER.      04450002
.*                                                                      04500002
.*                D1=(N) IS A KEYWORD PARAMETER THAT SPECIFIES THE      04550002
.*                FORMAT(S) OF THE DSCB(S) TO BE EXPANDED IN THE        04600002
.*                FIRST 140 BYTE DSCB AREA, USING THE IECSDSL1 MACRO.   04650002
.*                N CAN BE A NUMBER FROM 0 - 6.  IF N IS 0 OR 4 OR      04700002
.*                IF THIS KEYWORD IS OMITTED, NO LABELS ARE EXPANDED.   04750002
.*                IF N IS 1, 2, 3, 5, OR 6, THE CORRESPONDING FORMAT    04800002
.*                OF THE DSCB WILL BE EXPANDED.  MORE THAN ONE DSCB     04850002
.*                FORMAT CAN BE MAPPED IN THE FIRST 140 BYTE DSCB       04900002
.*                AREA BY SEPARATING THE FORMAT NUMBERS BY COMMAS.      04950002
.*                                                                      05000002
.*                D2=(N) IS A KEYWORD PARAMETER THAT SPECIFIES          05050002
.*                THE FORMAT(S) OF THE DSCB(S) TO BE EXPANDED IN THE    05100002
.*                SECOND 140 BYTE DSCB AREA, USING THE IECSDSL1 MACRO.  05150002
.*                N CAN BE A NUMBER FROM 0 - 6.  IF N IS 0 OR 4 OR      05200002
.*                IF THIS KEYWORD IS OMITTED, NO LABELS ARE EXPANDED.   05250002
.*                IF N IS 1, 2, 3, 5, OR 6, THE CORRESPONDING FORMAT    05300002
.*                OF THE DSCB WILL BE EXPANDED.  MORE THAN ONE DSCB     05350002
.*                FORMAT CAN BE MAPPED IN THE SECOND 140 BYTE DSCB      05400002
.*                AREA BY SEPARATING THE FORMAT NUMBERS BY COMMAS.      05450002
.*                                                                      05500002
