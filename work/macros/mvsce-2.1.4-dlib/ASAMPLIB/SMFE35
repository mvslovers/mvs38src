//SMFE35  JOB MSGLEVEL=1                                                00050002
//STEPB  EXEC  ASMFCL                                                   00100002
//ASM.SYSIN DD *                                                        00150002
         TITLE   'SMFE35-E35SMF'                                        00200002
* STATUS--CHANGE LEVEL 0000                                           * 00250002
* FUNCTION-THIS VERSION OF THE E35 SORT EXIT RE-INSERTS THE SYSTEM    * 00300002
*    ORIENTED RECORDS(SOR) INTO THE FINAL MERGED OUTPUT IN THE        * 00350002
*    FOLLOWING SEQUENCE-                                              * 00400002
*    1-ALL DUMP HDR RECORDS                                           * 00450002
*    2-ALL DUMP TLR RECORDS                                           * 00500002
*    3-ALL OTHER SYSTEM ORIENTED RECORDS IN THE SEQUENCE IN           * 00550002
*    WHICH THEY WERE GENERATED BY SYSTEM MANAGEMENT                   * 00600002
*    FACILITIES                                                       * 00650002
*    THE SORT WILL THEN PLACE INTO THE FINAL MERGED OUTPUT            * 00700002
*    THE SORTED JOB ORIENTED RECORDS                                  * 00750002
*    OPERATION ---                                                    * 00800002
*    UPON INITIAL ENTRY,THE HDR/TLR DATA SET IS OPENED.THE DATA       * 00850002
*    RECORDS ARE SCANNED FOR RECORD TYPE 2(DUMP HDR).EACH TIME        * 00900002
*    A TYPE 2 IS FOUND AND A RETURN IS MADE TO THE SORT TO HAVE       * 00950002
*    THE RECORD INSERT INTO THE FINAL OUTPUT.WHEN EODAD IS REACHED    * 01000002
*    THE SET IS CLOSED & RE-OPENED.THIS SCAN IS PERFORMED AGAIN,      * 01050002
*    THIS TIME FOR TYPE 3(DUMP TLR) AND ARE INSERTED AGAIN.AT         * 01100002
*    EODAD FOR THE SECOND TIME,THIS SET IS CLOSED PERMANENTLY.        * 01150002
*    THE OTHER TEMPORARY SET IS OPENED AND A LOOP IS EXECUTED         * 01200002
*    INSERTING EACH RECORD AS IT IS GOTTEN UNTIL EODAD IS             * 01250002
*    REACHED.AT THIS POINT,ALL SYSTEM ORIENTED RECORDS HAVE           * 01300002
*    BEEN PROCESSED AND AFTER CLOSING THE SET RETURN IS MADE TO       * 01350002
*    THE SORT WITH A RETURN CODE INDICATING THAT NO RETURN IS TO      * 01400002
*    BE MADE TO THIS EXIT.                                            * 01450002
* ENTRY POINTS--                                                      * 01500002
*         E35                                                         * 01550002
* INPUT- A-REGISTER 1 POINTS TO A WORD PARAMETER LIST THAT CONTAINS-  * 01600002
*    1-ADDRESS OF RECORD LEAVING MERGE                                * 01650002
*    2-ADDRESS OF RECORD IN OUTPUT AREA                               * 01700002
*    3-SEQUENCE CHECK SWITCH (SET TO SUPPRESS SEQUENCE CHECKING       * 01750002
*    WHILE THIS ROUTINE IS ACTIVE                                     * 01800002
*    B-2 TEMPORARY DATA SETS CREATED BY THE E15 EXIT ROUTINE.         * 01850002
*    THE FIRST CONTAINS ALL OF THE HEADERS AND TRAILERS FROM          * 01900002
*    THE DUMP TAPE(S) INPUTTED TO THE SORT                            * 01950002
*    THE SECOND CONTAINS ALL OTHER SYSTEM ORIENTED RECORDS            * 02000002
*    FROM THE DUMP TAPE(S) INPUTTED TO THE SORT                       * 02050002
* OUTPUT--SEE FUNCTION                                                * 02100002
*    RETURN CODES USED-RC=0 NO ACTION,RC=8 DO NOT RETURN,             * 02150002
*    RC=12 INSERT RECORD                                              * 02200002
* EXTERNAL REFERENCES--N/A                                            * 02250002
* EXITS,NORMAL--TO OS/SORT                                            * 02300002
* EXITS,ERROR--N/A                                                    * 02350002
* TABLES/WORK AREAS--N/A                                              * 02400002
* ATTRIBUTES--NON-REENTRANT,NON-REUSABLE                              * 02450002
* CHARACTER CODE DEPENDENCY--NONE                                     * 02500002
* NOTES-THE BUFFER USED IN THIS ROUTINE WAS DEFINED TO HOLD A         * 02550002
*    MAXIMUM RECORD SIZE OF 600 BYTES.  SOME INSTALLATIONS USE @YM00553 02600002
*    LARGER RECORDS AND SHOULD REDEFINE THIS BUFFER TO HOLD           * 02650002
*    THEIR MAXIMUM LOGICAL RECORD SIZE.                               * 02700002
*                                                                     * 02750002
R01      EQU   1                   PARAMETER REGISTER                   02800002
ONE      EQU   1                                                        02850002
R02      EQU   2                   WORK REGISTER                        02900002
III      EQU   X'03'                                                    02950002
IV       EQU   4                                                        03000002
V        EQU   5                                                        03050002
VIII     EQU   8                                                        03100002
R08      EQU   8                   SOR ADDRESS REGISTER                 03150002
R10      EQU   10                  WORKING REGISTER FOR SORT RECD ADDR  03200002
R11      EQU   11                  PARAMETER LIST ADDRESS REGISTER      03250002
R12      EQU   12                  BASE REGISTER                        03300002
R13      EQU   13                  SAVE AREA ADDRESS REGISTER           03350002
R15      EQU   15                  ENTRY POINT REGISTER                 03400002
XXIV     EQU   24                                                       03450002
INSERT   EQU   X'01'                                                    03500002
JTERM    EQU   X'05'                                                    03550002
ONCE     EQU   X'20'               1ST SOR PROCESS SWITCH               03600002
CLOSONCE EQU   X'24'               SWITCH MASKS/HDRS DONE & 1ST SOR     03650002
ONCEOVER EQU   X'DF'                                                    03700002
INSOFF   EQU   X'FE'                                                    03750002
CLOSED   EQU   X'02'               FINAL END OF DS ACTIVITY             03800002
CLOSEA   EQU   X'04'               HDR/TRL PROCESSING FINISHED          03850002
OPENA    EQU   X'08'               HDR/TRL HAS BEEN OPENED              03900002
PASS2    EQU   X'10'               HDR/TRL CLOSED ONCE BEFORE           03950002
E35      CSECT                                                          04000002
*D 068000-080500                                               @YM00553 04010002
*A 026000,067500                                               @YM00553 04020002
*A 050000,059500,066000-067500                                   A35184 04050002
         USING *,R12               ESTABLISH ADDRESSABILTY              04100002
         SAVE  (14,12)             SAVE CALLER'S REGS                   04150002
         LR    R12,R15             LOAD BASE ADDRESS                    04200002
         ST    R13,SAVDS+IV        CHAIN SORT SAVEAREA TO E35           04350002
         LR    R02,R13             RETAIN ADDRESS OF SORT'S AREA        04400002
         LA    R13,SAVDS           ADDRESS OF E35 SAVE AREA             04450002
         ST    R13,VIII(R02)       CHAIN E35 SAVEAREA TO SORT           04500002
         LR    R11,R01             RETAIN PARAMETER LIST ADDRESS        04550002
         LA    R02,IV              CREATE NO SEQ CHECK BIT              04600002
         ST    R02,VIII(R11)       PLACE IN SORT PARM LIST              04650002
         TM    BITS,CLOSEA         IS HDR SET CLOSED                    04700002
         BO    E35PROC             YES,BYPASS HDR INSERTIONS            04750002
         TM    BITS,OPENA          IS HDR SET OPEN                      04800002
         BO    E35XCPTA            YES,BYPASS OPENING                   04850002
         OPEN  E35DCBA             NO,OPEN FOR FIRST SCAN               04900002
         OI    BITS,OPENA          TURN ON OPEN INDICATOR               04950002
E35XCPTA GET   E35DCBA,HTBUFF      GET A HDR/TLR RECORD          A35184 05000002
         CLC   V(ONE,R01),ID       IS THIS THE RIGHT TYPE               05050002
         BNE   E35XCPTA            NO,GET NEXT RECORD                   05100002
         B     E35INRTN            YES,GO TO INSERT RETURN              05150002
E35EODID CLOSE E35DCBA             CLOSE HDR/TLR SET                    05200002
         TM    BITS,PASS2          HAS SET BEEN CLOSED ONCE             05250002
         BO    E35XCPTB            SET END OF PHASE BIT AND GO ON       05300002
         MVI   ID,III              NO,CHANGE ID BEING SCANNED FOR       05350002
         OPEN  E35DCBA             OPEN HDR/TLR SET SECOND TIME         05400002
         OI    BITS,PASS2          INDICATE HDR/TLR SET CLOSED ONCE     05450002
         B     E35XCPTA            GO PERFORM SCAN                      05500002
E35XCPTB OI    BITS,CLOSONCE       SET SWITCHES TO INDICATE HDR SET     05550002
*                                  SET CLOSED AND FIRST TIME FOR        05600002
*                                  SOR PROCESSING                       05650002
         B     E35PROC             YES,GO PROCESS REST OF SOR'S         05700002
E35PROC  L     R08,SORSAV          LOAD ADDRESS OF CURRENT SOR          05750002
         LTR   R08,R08             IS IT ZERO                           05800002
         BNE   E35PRCS             NO,DATA SET IS OPEN                  05850002
         OPEN  E35DCB              OPEN DATA SET CREATED AT E15 EXIT    05900002
E35PRCS  GET   E35DCB,BUFF         GET THE FIRST RECORD          A35184 05950002
         ST    R01,SORSAV          SAVE THE ADDRESS OF RECORD           06000002
E35INRTN L     R13,SAVDS+IV        ADDRESS OF SORT SAVE AREA            06050002
         ST    R01,XXIV(R13)       ADDRESS OF RECD INTO SORT SAVEAREA   06100002
         RETURN (14,12),RC=12      RETURN TO SORT W/RC=INSERT           06150002
E35EODAD CLOSE E35DCB              CLOSE SOR SET                        06200002
         OI    BITS,CLOSED         TURN ON CLOSED BIT                   06250002
E35ENDB  L     R13,SAVDS+IV                                             06300002
         RETURN (14,12),RC=8       DO NOT RETURN                        06350002
SAVDS    DS    18F                 REGISTER SAVE AREA                   06400002
SORSAV   DC    F'0'                SOR ADDRESS                          06450002
BITS     DC    X'00'               INITIALIZE SWITCH                    06500002
ID       DC    X'02'               INITIALIZE ID                        06550002
E35DCB   DCB   DSORG=PS,MACRF=GM,DDNAME=SORDATA,EODAD=E35EODAD   A35184 06600002
E35DCBA  DCB   DSORG=PS,MACRF=GM,DDNAME=HDRDATA,EODAD=E35EODID   A35184 06650002
HTBUFF   DS    CL18                BUFFER FOR HDR/TLR RECORDS    A35184 06700002
BUFF     DS    CL608               BUFF TO REBUILD SEGMTED REC @YM00553 06750002
         END                                                            08100002
