# Copy to .env (gitignored) and fill in. The tools resolve, first hit wins:
#   MVS_CRED in the environment, then MVS_CRED_<SYSTEM>, then <SYSTEM>_CRED here,
#   then DEFAULT_CRED. See tools/creds.py.
#
# System names are the keys of tools/systems.json, with '-' written as '_'.
# There is no built-in fallback: a tool that cannot find a credential stops,
# because a 401 loop looks exactly like an outage from the outside.

MVSCE_DEV_CRED=user:pass
MVSCE_LAB_CRED=user:pass
MVSCE_EXP_CRED=user:pass
MVSTK5_REF_CRED=user:pass
MVSTK5_BLD_CRED=user:pass
